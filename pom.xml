<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.rockhopper.smarthome</groupId>
	<artifactId>parent</artifactId>
	<version>${revision}${sha1}${changelist}</version>
	<packaging>pom</packaging>
	<name>SmartHome POM</name>
	<description>Parent for SmartHome Projects</description>

	<properties>
		<!-- CI-friendly versioning -->
		<revision>0.9.1-beta</revision>
		<sha1/>
		<changelist/>
		
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- GPG signing can be skipped with -Dgpg.skip=true -->
		<gpg.skip>false</gpg.skip>
	</properties>

	<url>https://github.com/rockyhopper/smarthome</url>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<name>Johann Dupuis</name>
			<email>smarthome@rockhopper.org</email>
			<organization>rockhopper</organization>
			<organizationUrl>https://www.rockhopper.org/</organizationUrl>
		</developer>
	</developers>

	<scm>
		<connection>scm:git:git://github.com/rockyhopper/smarthome.git</connection>
		<developerConnection>scm:git:ssh://github.com:rockyhopper/smarthome.git</developerConnection>
		<url>https://github.com/rockyhopper/smarthome/tree/master</url>
	</scm>

	<distributionManagement>
		<!-- Remove OSSRH URLs as they are no longer needed with Central Portal -->
		<!-- Central Publishing Maven Plugin will handle the publishing -->
	</distributionManagement>

	<modules>
		<module>wes</module>
		<module>hsb</module>
	</modules>

	<build>
		<plugins>
			<!-- Flatten Maven Plugin for CI-friendly versioning -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
				<version>1.5.0</version>
				<configuration>
					<updatePomFile>true</updatePomFile>
					<flattenMode>resolveCiFriendliesOnly</flattenMode>
					<pomElements>
						<parent>resolve</parent>
						<name>resolve</name>
						<description>resolve</description>
						<developers>resolve</developers>
						<contributors>resolve</contributors>
					</pomElements>
				</configuration>
				<executions>
					<execution>
						<id>flatten</id>
						<phase>process-resources</phase>
						<goals>
							<goal>flatten</goal>
						</goals>
					</execution>
					<execution>
						<id>flatten.clean</id>
						<phase>clean</phase>
						<goals>
							<goal>clean</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- Replace Nexus Staging Plugin with Central Publishing Plugin -->
			<plugin>
				<groupId>org.sonatype.central</groupId>
				<artifactId>central-publishing-maven-plugin</artifactId>
				<version>0.8.0</version>
				<extensions>true</extensions>
				<configuration>
					<publishingServerId>central</publishingServerId>
					<autoPublish>true</autoPublish>
					<waitUntil>published</waitUntil>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<version>3.2.1</version>
				<executions>
					<execution>
						<id>attach-sources</id>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-javadoc-plugin</artifactId>
				<version>3.4.1</version>
				<executions>
					<execution>
						<id>attach-javadocs</id>
						<goals>
							<goal>jar</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- To skip GPG use -Dgpg.skip -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-gpg-plugin</artifactId>
				<version>3.0.1</version>
				<executions>
					<execution>
						<id>sign-artifacts</id>
						<phase>verify</phase>
						<goals>
							<goal>sign</goal>
						</goals>
						<configuration>
							<!-- Skip GPG signing in CI environments -->
							<skip>${gpg.skip}</skip>
							<executable>/usr/bin/gpg</executable>
							<keyname>2B59FFA42A054A17</keyname>
							<gpgArguments>
								<arg>--pinentry-mode</arg>
								<arg>loopback</arg>
								<arg>--batch</arg>
								<arg>--no-tty</arg>
								<arg>--yes</arg>
							</gpgArguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
